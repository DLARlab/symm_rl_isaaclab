+        self.bias = torch.nn.Parameter(torch.tensor(-0.2))
+        self.is_recurrent = False
+
+    def forward(self, observations, **_kwargs):
+        value = self.weight * observations["policy"][:, 1] + self.bias
+        return value.unsqueeze(-1)
